rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isBoardMember(boardId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/boards/$(boardId)/members/$(request.auth.uid));
    }

    match /boards/{boardId}/resources/{resourceId} {
      allow read, create, update, delete: if isBoardMember(boardId);
    }

    match /boards/{boardId}/itineraryItems/{itemId} {
      allow read, create, update, delete: if isBoardMember(boardId);
    }

    match /boards/{boardId}/members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
